# Copy to .env and fill in. Never commit .env. Names and shapes only: no real values belong in this file.

# Aiven for Valkey (working memory, timers). Key-expiry events must be on: set valkey_notify_keyspace_events to Ex
VALKEY_URI=rediss://default:PASSWORD@HOST.aivencloud.com:PORT?ssl_cert_reqs=none
# Aiven for PostgreSQL with the pgvector extension (long-term memory, alerts, documents)
POSTGRES_URI=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require

ANTHROPIC_API_KEY=            # replies and document reading
EMBEDDINGS_API_KEY=           # OpenAI key: embeddings, and the fallback for replies
ELEVENLABS_API_KEY=           # only needed to create or edit the voice agent (create_agent.py); the server does not use it

# A long random string. Every backend route requires it; the website's proxy adds it, so it never reaches a browser.
AGENT_SHARED_SECRET=

# Seconds of silence before the companion checks in. 30 for demos, 14400 (4 hours) for real use.
INACTIVITY_SECONDS=14400
PATIENT_TZ=Europe/Paris

# Phone alerts through Telegram (optional)
TELEGRAM_BOT_TOKEN=           # from BotFather. Revoke and replace it when you are done.
TELEGRAM_WEBHOOK_SECRET=      # a random string, also given to Telegram's setWebhook as secret_token
PORTAL_URL=https://your-site.vercel.app
