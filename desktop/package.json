{
  "name": "memory-lane-desktop",
  "version": "0.1.0",
  "description": "Memory Lane: a voice companion that lives in the Mac menu bar",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.memorylane.desktop",
    "productName": "Memory Lane",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Memory Lane listens only while you are talking to it."
      }
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
